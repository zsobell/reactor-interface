
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python
.venv/
__pycache__/
*.pyc

# Machine-local Claude Code settings (permissions, not shared config)
.claude/settings.local.json

# Experimental run data. Each run writes several MB into data/<run name>/ and
# those files are the experiment's record, not the program's source - they do
# not belong in the control software's history. One params file from the very
# first commit was tracked by accident and is dropped here; it stays on disk.
data/
server.log
config/run_params.json

# One JSON file per RUNNING server, so the Shut down button can find the others
# (reactor/instances.py). Live process state - meaningless on another machine
# and stale the moment this one reboots.
config/instances/
